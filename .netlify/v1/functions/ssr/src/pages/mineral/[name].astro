---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MineralDetailData from '../../components/MineralDetailData.tsx';

export const prerender = false;

const { name } = Astro.params;
---

<BaseLayout
  title={name || 'Mineral Detail'}
  description={`Learn about ${name}`}
>
  <MineralDetailData slug={name} client:load />
</BaseLayout>
