---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { getFAQs } from '../lib/database';

// Get FAQs from Supabase
const faqs = await getFAQs();

const quickLinks = [
  {
    title: 'Museum Map',
    icon: 'fas fa-map',
    description: 'Download our interactive museum map',
    link: '#',
  },
  {
    title: 'Accessibility',
    icon: 'fas fa-wheelchair',
    description: 'Information about accessibility features',
    link: '#',
  },
  {
    title: 'Group Visits',
    icon: 'fas fa-users',
    description: 'Plan your group or school visit',
    link: '#',
  },
  {
    title: 'Membership',
    icon: 'fas fa-ticket-alt',
    description: 'Learn about membership benefits',
    link: '#',
  },
];
---

<BaseLayout
  title="Help & FAQ"
  description="Get help and find answers to frequently asked questions"
>
  <Hero
    title="Help Center"
    subtitle="Find answers to common questions and get the support you need"
  />

  <!-- Quick Links -->
  <section class="section-padding bg-base-200">
    <div class="container-brand">
      <h2 class="text-3xl font-bold text-center mb-12">Quick Links</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          quickLinks.map((link) => (
            <a href={link.link} class="card bg-base-100 shadow-xl hover-lift">
              <div class="card-body items-center text-center">
                <i class={`${link.icon} text-4xl mb-2 text-primary`} />
                <h3 class="card-title text-lg">{link.title}</h3>
                <p class="text-sm text-base-content/70">{link.description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section-padding">
    <div class="container-brand">
      <h2 class="text-3xl font-bold text-center mb-12">Frequently Asked Questions</h2>
      <div class="max-w-4xl mx-auto space-y-4">
        {
          faqs.map((faq, index) => (
            <div class="collapse collapse-plus bg-base-200">
              <input type="radio" name="faq-accordion" checked={index === 0} />
              <div class="collapse-title text-xl font-medium">{faq.question}</div>
              <div class="collapse-content">
                <p class="pt-2 text-base-content/80">{faq.answer}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="section-padding bg-base-200">
    <div class="container-brand">
      <h2 class="text-3xl font-bold text-center mb-12">Still Need Help?</h2>
      <div class="card bg-base-100 shadow-xl max-w-2xl mx-auto">
        <div class="card-body">
          <h3 class="text-2xl font-bold mb-6 text-center">Contact the Museum Director</h3>
          <div class="space-y-4">
            <p class="text-lg font-semibold">Kent Ratajeski</p>
            <p class="text-base-content/70">Professor, Bruce Dice Museum Director</p>
            <div class="divider"></div>
            <p class="flex items-center gap-2">
              <i class="fas fa-phone text-primary"></i>
              <a href="tel:+16165266769" class="link link-hover">(616) 526-6769</a>
            </p>
            <p class="flex items-center gap-2">
              <i class="fas fa-envelope text-primary"></i>
              <a href="mailto:kent.ratajeski@calvin.edu" class="link link-hover">
                kent.ratajeski@calvin.edu
              </a>
            </p>
            <div class="divider"></div>
            <p class="flex items-center gap-2">
              <i class="fas fa-map-marker-alt text-primary"></i>
              <span>North Hall 162, 1740 Knollcrest Circle SE, Grand Rapids, MI 49546-4403</span>
            </p>
            <p class="flex items-center gap-2">
              <i class="fas fa-clock text-primary"></i>
              <span>August 29-December 11 (except university holidays)</span>
            </p>
            <div class="text-sm">
              <p>Monday-Thursday: 12-5 PM</p>
              <p>Friday: 12-4 PM</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
