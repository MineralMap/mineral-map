---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getMinerals } from '../../lib/database';

// This is a dynamic route for mineral pages
export async function getStaticPaths() {
  try {
    // Fetch minerals from database
    const minerals = await getMinerals();
    
    return minerals.map((mineral) => ({
      params: { name: mineral.id },
      props: { mineral },
    }));
  } catch (error) {
    console.error('Error fetching minerals for static paths:', error);
    return [];
  }
}

const { mineral } = Astro.props;

if (!mineral) {
  return Astro.redirect('/minerals');
}
---

<BaseLayout
  title={mineral.title}
  description={`Learn about ${mineral.title} - ${mineral.description}`}
>
  <section class="section-padding">
    <div class="container-brand">
      <div class="max-w-4xl mx-auto">
        <!-- Back Button -->
        <div class="mb-8">
          <a href="/minerals" class="btn btn-ghost btn-sm">
            <i class="fas fa-arrow-left mr-2"></i>
            Back to Minerals
          </a>
        </div>

        <!-- Mineral Header -->
        <div class="text-center mb-8 lg:mb-12">
          <h1 class="text-3xl md:text-4xl font-bold text-primary mb-4">
            <i class="fas fa-gem mr-2 md:mr-3"></i>
            {mineral.title}
          </h1>
        </div>

        <!-- Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
          <!-- Video Section -->
          <div class="space-y-6">
            <div class="card bg-base-100 shadow-xl">
              <div class="card-body">
                <h2 class="card-title text-xl mb-4">
                  <i class="fas fa-play-circle mr-2"></i>
                  Video Presentation
                </h2>
                <video controls poster="/placeholder.jpg" class="w-full rounded-lg">
                  <source src="/videos/test.mp4" type="video/mp4" />
                  Your browser does not support the video tag.
                </video>
              </div>
            </div>
          </div>

          <!-- Information Section -->
          <div class="space-y-6">
            <div class="card bg-base-100 shadow-xl">
              <div class="card-body">
                <h2 class="card-title text-xl mb-4">
                  <i class="fas fa-info-circle mr-2"></i>
                  About {mineral.title}
                </h2>
                <p class="text-base-content/80 leading-relaxed text-lg">
                  {mineral.description}
                </p>
              </div>
            </div>

            <!-- Properties Card -->
            <div class="card bg-base-100 shadow-xl">
              <div class="card-body">
                <h2 class="card-title text-xl mb-4">
                  <i class="fas fa-list mr-2"></i>
                  Properties
                </h2>
                <div class="space-y-3">
                  <div class="flex justify-between items-start">
                    <span class="font-medium">Classification:</span>
                    <div class="text-right">
                      {Array.isArray(mineral.tags) ? (
                        <div class="flex flex-wrap gap-1 justify-end">
                          {mineral.tags.map((tag) => (
                            <span class="badge badge-outline badge-sm">{tag}</span>
                          ))}
                        </div>
                      ) : mineral.tags ? (
                        <span class="badge badge-outline badge-sm">{mineral.tags}</span>
                      ) : (
                        <span class="text-base-content/60">Not specified</span>
                      )}
                    </div>
                  </div>
                  <div class="flex justify-between">
                    <span class="font-medium">Status:</span>
                    <span class={`badge ${
                      mineral.status === 'published' ? 'badge-success' :
                      mineral.status === 'draft' ? 'badge-warning' :
                      mineral.status === 'hidden' ? 'badge-error' :
                      'badge-neutral'
                    }`}>
                      {mineral.status || 'Unknown'}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
